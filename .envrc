# Loaded by direnv when you cd into this repo (run `direnv allow` once).
# The token lives in the macOS Keychain, never in a file, as gh-token-<this folder's name>.
# The folder name must match the repo name. Setup: docs/process/github-setup.md
export GH_TOKEN="$(security find-generic-password -s "gh-token-$(basename "$PWD")" -a "$USER" -w 2>/dev/null)"
